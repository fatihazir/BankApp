{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "AnonymousAuth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Security": {
    "Jwt": {
      "Issuer": "BankApp",
      "Audience": "BankApp.Clients",
      "SecurityKey": "",
      "AccessTokenExpirationMinutes": 10,
      "RefreshTokenExpirationMinutes": 30
    }
  },
  "Mailing": {
    "LogBody": false
  },
  "ConnectionStrings": {
    "BankAppDb": ""
  }
}
